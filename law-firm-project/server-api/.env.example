PORT=3000
NODE_ENV=development

# sqlite (dev, không cần MySQL) hoặc mysql
DB_DIALECT=sqlite
DB_STORAGE=./data/law_firm.sqlite

# MySQL — đặt DB_DIALECT=mysql và điền:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=law_firm_db
# DB_USER=root
# DB_PASSWORD=

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=8h

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me-internal-key

CORS_ORIGIN=http://localhost:5173
