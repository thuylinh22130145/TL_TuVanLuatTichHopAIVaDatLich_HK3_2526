PORT=3000
NODE_ENV=development

# sqlite (dev, không cần MySQL) hoặc mysql
DB_DIALECT=sqlite
DB_STORAGE=./data/law_firm.sqlite

# MySQL — đặt DB_DIALECT=mysql và điền:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=law_firm_db
# DB_USER=root
# DB_PASSWORD=

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=8h
JWT_OTP_EXPIRES_IN=5m
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMTP Gmail. MAIL_PASSWORD phải là App Password, không dùng mật khẩu email.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=22130145@st.hcmuaf.edu.vn
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_NAME=Tu van phap ly AI

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me-internal-key

CORS_ORIGIN=http://localhost:5173
